{
  "name": "sarasotaconcrete",
  "compatibility_date": "2026-09-10",
  "pages_build_output_dir": "dist",

  // KV for the contact form's rate limit (5 submissions per rolling 10 minutes per IP).
  // Namespace "sarasotaconcrete-ratelimit", created 2026-09-11. It is deliberately NOT the shared
  // generic RATE_LIMIT_KV used by a sibling site: sharing it would rate-limit one visitor across
  // every hub at once.
  "kv_namespaces": [
    { "binding": "RATE_LIMIT_KV", "id": "2425ece680b2407a9aa3e60d0d961d44" }
  ],

  // The email Worker, enabled 2026-09-12. It could not be bound earlier: Cloudflare Email Workers
  // require Email Routing verified on the zone, and the zone only reached this account on
  // 2026-09-11, still carrying the registrar's null MX records that made Enable fail with error
  // 2008. With those cleared and routing ready, `sarasotaconcrete-contact` is deployed with its
  // send_email binding and DESTINATION_EMAIL secret, so functions/api/contact.js can hand the
  // validated submission off instead of returning a 502.
  //
  // This file is the Pages project's configuration: bindings set through the dashboard or the API
  // are ignored while it exists, which is why the binding has to live here and not only there.
  "services": [
    { "binding": "CONTACT_EMAIL", "service": "sarasotaconcrete-contact" }
  ]

  // TURNSTILE_SECRET_KEY stays a Pages environment secret, not a file binding. Without it the
  // function treats verification as skipped, so the form works before Turnstile is configured.
}
